#ifndef XENIA_GPU_SHADERS_RESOLVE_DIRECT_REFRESH_XESLI_
#define XENIA_GPU_SHADERS_RESOLVE_DIRECT_REFRESH_XESLI_

// The texture-cache image of a direct resolve's destination, written with what
// the loader would copy from the resolved memory: the texels before the endian
// swap. Up to three aliases - images of the same size loaded from the same
// memory with the same texel bits - get the same texels at the same
// coordinates. With XE_RESOLVE_DIRECT_REFRESH_64BPP, the images are RG32Uint
// views of 64bpb textures, a texel being the two dwords of a pixel.
#ifdef XE_RESOLVE_DIRECT_REFRESH_64BPP
#define XE_RESOLVE_DIRECT_REFRESH_TEXEL uint2_xe
#else
#define XE_RESOLVE_DIRECT_REFRESH_TEXEL uint
#endif
RWTexture2DArray<XE_RESOLVE_DIRECT_REFRESH_TEXEL> xe_resolve_refresh_texture
    : register(u4);
RWTexture2DArray<XE_RESOLVE_DIRECT_REFRESH_TEXEL> xe_resolve_refresh_alias_0
    : register(u5);
RWTexture2DArray<XE_RESOLVE_DIRECT_REFRESH_TEXEL> xe_resolve_refresh_alias_1
    : register(u6);
RWTexture2DArray<XE_RESOLVE_DIRECT_REFRESH_TEXEL> xe_resolve_refresh_alias_2
    : register(u7);

void XeResolveDirectRefreshWrite(uint2_xe texel,
                                 XE_RESOLVE_DIRECT_REFRESH_TEXEL value,
                                 uint alias_count) {
  xe_resolve_refresh_texture[uint3(texel, 0u)] = value;
  if (alias_count >= 1u) {
    xe_resolve_refresh_alias_0[uint3(texel, 0u)] = value;
  }
  if (alias_count >= 2u) {
    xe_resolve_refresh_alias_1[uint3(texel, 0u)] = value;
  }
  if (alias_count >= 3u) {
    xe_resolve_refresh_alias_2[uint3(texel, 0u)] = value;
  }
}

#ifdef XE_RESOLVE_DIRECT_REFRESH_64BPP
// Refresh the four pixels produced by a direct 64bpp resolve kernel, two in
// each of the vectors as the kernel packs them, with the texture's size,
// offsets and alias count in the two dwords at byte constants_offset of the
// EDRAM binding slot, laid out as for XeResolveDirectRefreshWrite4: the width
// below the row offset, and the height below the alias count and, in the top
// byte, the column offset in 32-texel tiles.
[ForceInline]
void XeResolveDirectRefreshWrite4x64(uint2_xe pixel_index, uint4_xe packed_01,
                                     uint4_xe packed_23,
                                     uint constants_offset) {
  uint texture_width_and_offset_y =
      byte_buffer_align4_load4_xe(xe_resolve_edram, constants_offset);
  uint texture_width = texture_width_and_offset_y & 0xFFFFu;
  uint texture_height_and_alias_count =
      byte_buffer_align4_load4_xe(xe_resolve_edram, constants_offset + 4u);
  uint texture_height = texture_height_and_alias_count & 0xFFFFu;
  uint alias_count = (texture_height_and_alias_count >> 16u) & 0xFFu;
  uint texture_x =
      pixel_index.x + ((texture_height_and_alias_count >> 24u) << 5u);
  uint texture_y = pixel_index.y + (texture_width_and_offset_y >> 16u);
  if (texture_y < texture_height) {
    if (texture_x < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x, texture_y),
                                  packed_01.xy, alias_count);
    }
    if (texture_x + 1u < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x + 1u, texture_y),
                                  packed_01.zw, alias_count);
    }
    if (texture_x + 2u < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x + 2u, texture_y),
                                  packed_23.xy, alias_count);
    }
    if (texture_x + 3u < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x + 3u, texture_y),
                                  packed_23.zw, alias_count);
    }
  }
}
#else
// Refresh the four pixels produced by either direct RGB10 resolve kernel.
[ForceInline]
void XeResolveDirectRefreshWrite4(uint2_xe pixel_index, uint4_xe packed) {
  uint texture_width_and_offset_y =
      byte_buffer_align4_load4_xe(xe_resolve_edram, 8u);
  uint texture_width = texture_width_and_offset_y & 0xFFFFu;
  uint texture_height_and_alias_count =
      byte_buffer_align4_load4_xe(xe_resolve_edram, 12u);
  uint texture_height = texture_height_and_alias_count & 0xFFFFu;
  uint alias_count = (texture_height_and_alias_count >> 16u) & 0xFFu;
  uint texture_x =
      pixel_index.x + ((texture_height_and_alias_count >> 24u) << 5u);
  uint texture_y = pixel_index.y + (texture_width_and_offset_y >> 16u);
  if (texture_y < texture_height) {
    if (texture_x < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x, texture_y),
                                  packed.x, alias_count);
    }
    if (texture_x + 1u < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x + 1u, texture_y),
                                  packed.y, alias_count);
    }
    if (texture_x + 2u < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x + 2u, texture_y),
                                  packed.z, alias_count);
    }
    if (texture_x + 3u < texture_width) {
      XeResolveDirectRefreshWrite(uint2_xe(texture_x + 3u, texture_y),
                                  packed.w, alias_count);
    }
  }
}
#endif  // XE_RESOLVE_DIRECT_REFRESH_64BPP

#endif  // XENIA_GPU_SHADERS_RESOLVE_DIRECT_REFRESH_XESLI_
