# cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P shader_cache_version.cmake
#
# Writes XE_METAL_SHADER_CACHE_SOURCE, a hash of everything that shapes the
# Metal libraries MetalShaderLibraryCache stores, so the stored libraries
# survive app updates that leave translation alone and are discarded by any
# that don't:
# - our translation sources: the seed files below and every xenia/gpu header
#   they include, followed recursively, with the .cc of each translation
#   header, by content (uncommitted edits included);
# - the compilers they call (spirv2air, Mesa's spirv_to_dxil, glslang's SPIR-V
#   builder, SPIRV-Tools, SPIRV-Headers), by commit and uncommitted diff.
# The runtime adds the GPU and Metal options and the Metal shader converter's
# build (MetalShaderLibraryCache::MakeFingerprint). The header is rewritten
# only when the hash changes, so an unchanged hash rebuilds nothing.

set(gpu "${SOURCE_DIR}/src/xenia/gpu")
file(GLOB seeds
  "${gpu}/shader.cc" "${gpu}/shader_translator*.cc" "${gpu}/spirv_*.cc"
  "${gpu}/ucode.cc" "${gpu}/xenos.cc" "${gpu}/draw_util.cc"
  "${gpu}/metal/dxil_shader.cc" "${gpu}/metal/metal_shader_converter.cc"
  "${gpu}/metal/metal_shader_library_cache.cc")
set(pending ${seeds})
set(files "")
while(pending)
  list(POP_FRONT pending file)
  if(file IN_LIST files OR NOT EXISTS "${file}")
    continue()
  endif()
  list(APPEND files "${file}")
  file(STRINGS "${file}" includes REGEX "^#include \"xenia/gpu/[^\"]+\"")
  foreach(line IN LISTS includes)
    string(REGEX REPLACE "^#include \"(xenia/gpu/[^\"]+)\".*" "\\1" header "${line}")
    set(path "${SOURCE_DIR}/src/${header}")
    list(APPEND pending "${path}")
    # The code behind a translation header, not that of every header the
    # translator reads constants from (render targets, textures).
    get_filename_component(name "${path}" NAME_WE)
    if(name MATCHES "^(shader|spirv_|ucode|xenos|draw_util|dxil_shader|metal_shader_)")
      string(REGEX REPLACE "\\.h$" ".cc" source "${path}")
      list(APPEND pending "${source}")
    endif()
  endforeach()
endwhile()
list(SORT files)

set(text "metal-shader-cache-v1\n")
foreach(file IN LISTS files)
  file(SHA256 "${file}" hash)
  file(RELATIVE_PATH relative "${SOURCE_DIR}" "${file}")
  string(APPEND text "${relative} ${hash}\n")
endforeach()

find_package(Git QUIET)
foreach(dir spirv2air mesa glslang SPIRV-Tools SPIRV-Headers)
  set(path "${SOURCE_DIR}/third_party/${dir}")
  set(head "")
  set(diff "")
  if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${path}" rev-parse HEAD
                    OUTPUT_VARIABLE head ERROR_QUIET
                    OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE head_result)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${path}" diff HEAD
                    OUTPUT_VARIABLE diff ERROR_QUIET RESULT_VARIABLE diff_result)
  endif()
  if(NOT head OR head_result OR diff_result)
    # Without git the state of the compiler is unknown: a new key every build,
    # as with a key on the executable.
    string(TIMESTAMP head "unknown-%Y%m%d%H%M%S" UTC)
  endif()
  string(SHA256 diff_hash "${diff}")
  string(APPEND text "third_party/${dir} ${head} ${diff_hash}\n")
endforeach()

string(SHA256 key "${text}")
set(content "// Generated by shader_cache_version.cmake.\n#define XE_METAL_SHADER_CACHE_SOURCE \"${key}\"\n")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
endif()
# The inputs behind the key, for checking what invalidated a cache.
file(WRITE "${OUTPUT}.txt" "${text}")
